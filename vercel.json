{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": [
    "iad1"
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/en/blog/:slug",
      "destination": "https://www.nexitel.us/blog/:slug",
      "permanent": true
    },
    {
      "source": "/:locale(zh|es)/blog/:slug",
      "destination": "https://www.nexitel.us/:locale/blog/:slug",
      "permanent": true
    },
    {
      "source": "/:locale(zh|es)",
      "destination": "https://www.nexitel.us/:locale/blog",
      "permanent": true
    },
    {
      "source": "/:locale(zh|es)/:path*",
      "destination": "https://www.nexitel.us/:locale/blog",
      "permanent": true
    },
    {
      "source": "/:path*",
      "destination": "https://www.nexitel.us/blog",
      "permanent": true
    }
  ]
}
